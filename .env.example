# Public site URL (used for canonical URLs, sitemap and metadata). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Contact form email delivery (Resend: https://resend.com) ---
# Leave unset and the form will tell visitors honestly that it is not connected yet.
RESEND_API_KEY=
# Address that receives contact form messages (the store's inbox).
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Hadi Website <website@yourdomain.ie>"
CONTACT_FROM_EMAIL=

# Random string (32+ chars) used to sign the form timing token. Generate with: openssl rand -hex 32
CONTACT_FORM_SECRET=
